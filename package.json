{
  "name": "biggym-landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page da academia Big Gym — HTML, CSS e JavaScript",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/servidor.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint style.css",
    "lint:js": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^30.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "vitest": "^5.0.4"
  }
}
